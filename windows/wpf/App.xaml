<Application x:Class="WarpConnect.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- Android palette, exact tokens from Theme.kt -->
        <Color x:Key="Surface">#0B1220</Color>
        <Color x:Key="BackgroundTop">#05070F</Color>
        <Color x:Key="BackgroundBottom">#13203A</Color>
        <Color x:Key="SurfaceVariant">#13203A</Color>
        <Color x:Key="CardFill">#0F1930</Color>
        <Color x:Key="CardBorder">#1A2A44</Color>
        <Color x:Key="Primary">#38BDF8</Color>
        <Color x:Key="Secondary">#22D3EE</Color>
        <Color x:Key="TealShade">#2DD4BF</Color>
        <Color x:Key="ConnectedGreen">#34D399</Color>
        <Color x:Key="ConnectedGreenDeep">#10B981</Color>
        <Color x:Key="Amber">#FBBF24</Color>
        <Color x:Key="AmberDeep">#D97706</Color>
        <Color x:Key="Red">#F87171</Color>
        <Color x:Key="RedDeep">#EF4444</Color>
        <Color x:Key="OnPrimary">#04121F</Color>
        <Color x:Key="OnSurface">#E6EDF7</Color>
        <Color x:Key="Muted">#A9B8CF</Color>
        <Color x:Key="MutedDim">#7A88A3</Color>

        <Color x:Key="DangerSurface">#2A1215</Color>

        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
        <SolidColorBrush x:Key="TealShadeBrush" Color="{StaticResource TealShade}" />
        <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource ConnectedGreen}" />
        <SolidColorBrush x:Key="ConnectedDeepBrush" Color="{StaticResource ConnectedGreenDeep}" />
        <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}" />
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}" />
        <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimary}" />
        <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
        <SolidColorBrush x:Key="MutedDimBrush" Color="{StaticResource MutedDim}" />


        <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style x:Key="MonoData" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
        </Style>

        <Style x:Key="TealLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TealShadeBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#7DF3D8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource MutedDimBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
