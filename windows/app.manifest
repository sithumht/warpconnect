  <assemblyIdentity version="1.0.1.0" name="com.warpconnect.windows" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- The WinTUN adapter, routes and DNS are created by the engine; elevation is mandatory. -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <asmv2:compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
