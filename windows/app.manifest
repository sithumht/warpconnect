    </asmv2:application>
  </asmv2:compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns="http://schemas.microsoft.com/win/2005/02/windowsscaling">
      <dpiAwareness>PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
